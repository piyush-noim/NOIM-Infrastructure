{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noim.dev/contracts/v1/resource-descriptor.schema.json",
  "title": "NOIM Resource Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "location"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["compute", "storage", "network", "service"]},
    "location": {"type": "string", "enum": ["local", "lan", "noim-node", "cloud", "edge"]},
    "provider": {"type": "string", "minLength": 1, "description": "Optional adapter identifier, never a provider credential."},
    "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "metadata": {"type": "object"}
  }
}
