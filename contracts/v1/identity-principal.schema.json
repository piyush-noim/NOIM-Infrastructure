{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noim.dev/contracts/v1/identity-principal.schema.json",
  "title": "NOIM Identity Principal",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "description": "Stable, non-secret principal identifier."},
    "kind": {"type": "string", "enum": ["human", "developer", "service", "ai-agent"]},
    "displayName": {"type": "string", "minLength": 1},
    "attributes": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
  }
}
